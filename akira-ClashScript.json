    SteamCN: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/SteamCN/SteamCN_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/SteamCN_No_Resolve.yaml",
    },
    Steam: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Steam/Steam_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Steam_No_Resolve.yaml",
    },
    GoogleFCM: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/GoogleFCM/GoogleFCM_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/GoogleFCM_No_Resolve.yaml",
    },
    GameDownloadCN: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Game/GameDownloadCN/GameDownloadCN_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/GameDownloadCN_No_Resolve.yaml",
    },
    Lan: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Lan/Lan_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Lan_No_Resolve.yaml",
    },
    ChinaMAX: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@refs/heads/master/rule/Clash/ChinaMaxNoIP/ChinaMaxNoIP_Classical_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/ChinaMaxNoIP_Classical_No_Resolve.yaml",
    },
    ChinaIP: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/DH-Teams/DH-Geo_AS_IP_CN@main/Geo_AS_IP_CN_All_Clash.yaml",
      interval: 86400,
      path: "./ruleset/Geo_AS_IP_CN_All_Clash.yaml",
    },
  };

  // ── 5. 路由规则 ──────────────────────────────────────
  const rules = [
    "RULE-SET,Lan,DIRECT",
    "IP-CIDR,43.163.8.237/32,DIRECT,no-resolve",
    "RULE-SET,GameDownloadCN,DIRECT",
    "RULE-SET,GoogleFCM,GoogleFCM",
    // Telegram 手动域名/IP 规则
    "DOMAIN,api.imem.app,Telegram",
    "DOMAIN,api.swiftgram.app,Telegram",
    "DOMAIN-SUFFIX,cdn-telegram.org,Telegram",
    "DOMAIN-SUFFIX,comments.app,Telegram",
    "DOMAIN-SUFFIX,contest.com,Telegram",
    "DOMAIN-SUFFIX,graph.org,Telegram",
    "DOMAIN-SUFFIX,legra.ph,Telegram",
    "DOMAIN-SUFFIX,mbrx.app,Telegram",
    "DOMAIN-SUFFIX,quiz.directory,Telegram",
    "DOMAIN-SUFFIX,stel.com,Telegram",
    "DOMAIN-SUFFIX,t.me,Telegram",
    "DOMAIN-SUFFIX,tdesktop.com,Telegram",
    "DOMAIN-SUFFIX,telega.one,Telegram",
    "DOMAIN-SUFFIX,telegra.ph,Telegram",
    "DOMAIN-SUFFIX,telegram-cdn.org,Telegram",
    "DOMAIN-SUFFIX,telegram.dog,Telegram",
    "DOMAIN-SUFFIX,telegram.me,Telegram",
    "DOMAIN-SUFFIX,telegram.org,Telegram",
    "DOMAIN-SUFFIX,telegram.space,Telegram",
    "DOMAIN-SUFFIX,telegramdownload.com,Telegram",
    "DOMAIN-SUFFIX,telesco.pe,Telegram",
    "DOMAIN-SUFFIX,tg.dev,Telegram",
    "DOMAIN-SUFFIX,tx.me,Telegram",
    "DOMAIN-SUFFIX,usercontent.dev,Telegram",
    "DOMAIN-KEYWORD,nicegram,Telegram",
    "IP-CIDR,109.239.140.0/24,Telegram,no-resolve",
    "IP-CIDR,149.154.160.0/20,Telegram,no-resolve",
    "IP-CIDR,5.28.192.0/18,Telegram,no-resolve",
    "IP-CIDR,91.108.0.0/16,Telegram,no-resolve",
    "IP-CIDR6,2001:67c:4e8::/48,Telegram,no-resolve",
    "IP-CIDR6,2001:b28:f23c::/47,Telegram,no-resolve",
    "IP-CIDR6,2001:b28:f23f::/48,Telegram,no-resolve",
    "IP-CIDR6,2a0a:f280::/29,Telegram,no-resolve",
    // 分流规则
    "RULE-SET,AI,AI",
    "RULE-SET,Apple,Apple",
    "RULE-SET,Netflix,Netflix",
    "RULE-SET,Instagram,Instagram",
    "RULE-SET,Spotify,Spotify",
    "RULE-SET,Disney,Disney",
    "RULE-SET,TikTok,TikTok",
    "RULE-SET,SteamCN,SteamCN",
    "RULE-SET,Steam,Steam",
    "RULE-SET,Google,Google",
    "RULE-SET,PayPal,PayPal",
    "RULE-SET,Microsoft,Microsoft",
    "RULE-SET,GlobalMedia,GlobalMedia",
    "RULE-SET,ChinaMAX,DIRECT",
    "RULE-SET,ChinaIP,DIRECT",
    "MATCH,Node",
  ];

  // ── 6. 组装最终配置 ──────────────────────────────────
  return {
    port: 7890,
    "socks-port": 7891,
    "allow-lan": true,
    "bind-address": "*",
    mode: "rule",
    "log-level": "info",
    ipv6: true,
    "unified-delay": true,
    "tcp-concurrent": true,
    profile: {
      "store-selected": true,
      "store-fake-ip": true,
    },
    dns,
    proxies,
    "proxy-groups": proxyGroups,
    "rule-providers": ruleProviders,
    rules,
  };
}
