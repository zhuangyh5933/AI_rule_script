// ==================================================
// Clash 覆写脚本 (Parser Script)
// 适用于 Clash Verge / Clash Meta / Mihomo
// 用法：Clash Verge -> 订阅 -> 右键编辑 -> 脚本 -> 粘贴保存
// ==================================================

function main(config) {
  // ── 1. 提取订阅中的所有节点 ──────────────────────────
  const proxies = config.proxies || [];
  const proxyNames = proxies.map((p) => p.name);

  if (proxyNames.length === 0) {
    console.log("[覆写] 未找到任何节点，请检查订阅是否有效");
  }

  // ── 2. DNS 配置 ──────────────────────────────────────
  const dns = {
    enable: true,
    "cache-algorithm": "arc",
    listen: "0.0.0.0:1053",
    ipv6: true,
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",
    "use-hosts": true,
    "default-nameserver": ["119.29.29.29", "223.5.5.5"],
    nameserver: [
      //"https://sm2.doh.pub/dns-query",
      "https://doh-pure.onedns.net/dns-query",
    ],
    "fake-ip-filter": [
      "*.lan",
      "localhost.ptlogin2.qq.com",
      "dns.msftncsi.com",
      "*.srv.nintendo.net",
      "*.stun.playstation.net",
      "xbox.*.microsoft.com",
      "*.xboxlive.com",
      "rule-set:Apple",
      "rule-set:Microsoft",
      "rule-set:GoogleFCM",
      "rule-set:ChinaMAX",
      "rule-set:Lan",
    ],
    fallback: ["1.1.1.1", "8.8.8.8"],
    "fallback-filter": {
      geoip: true,
      "geoip-code": "CN",
      ipcidr: ["240.0.0.0/4"],
    },
  };

  // ── 3. 代理组 ────────────────────────────────────────
  const proxyGroups = [
    {
      name: "Node",
      type: "select",
      proxies: ["Auto", ...proxyNames],
    },
    {
      name: "Auto",
      type: "fallback",
      proxies: [...proxyNames],
      url: "http://1.0.0.1",
      interval: 300,
    },
    {
      name: "Apple",
      type: "select",
      proxies: ["DIRECT", "Node", ...proxyNames],
    },
    {
      name: "AI",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "GoogleFCM",
      type: "select",
      proxies: ["Node", "DIRECT", ...proxyNames],
    },
    {
      name: "Instagram",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "Spotify",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "Netflix",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "Disney",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "TikTok",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "GlobalMedia",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "Google",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "Microsoft",
      type: "select",
      proxies: ["DIRECT", "Node", ...proxyNames],
    },
    {
      name: "SteamCN",
      type: "select",
      proxies: ["DIRECT", "Node", ...proxyNames],
    },
    {
      name: "Steam",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
    {
      name: "PayPal",
      type: "select",
      proxies: ["DIRECT", "Node", ...proxyNames],
    },
    {
      name: "Telegram",
      type: "select",
      proxies: ["Node", ...proxyNames],
    },
  ];

  // ── 4. Rule Providers ────────────────────────────────
  const ruleProviders = {
    Apple: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Apple/Apple_Classical_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Apple_No_Resolve.yaml",
    },
    Netflix: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Netflix_No_Resolve.yaml",
    },
    Disney: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Disney/Disney_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Disney_No_Resolve.yaml",
    },
    TikTok: {
      type: "http",
      behavior: "classical",
