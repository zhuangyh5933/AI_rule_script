      interval: 86400,
      path: "./ruleset/TikTok_No_Resolve.yaml",
    },
    GlobalMedia: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/GlobalMedia/GlobalMedia_Classical_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/GlobalMedia_Classical_No_Resolve.yaml",
    },
    AI: {
      type: "http",
      behavior: "classical",
      format: "text",
      url: "https://ruleset.skk.moe/LegacyClashPremium/non_ip/ai.txt",
      interval: 86400,
      path: "./ruleset/AI.txt",
    },
    Google: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Google/Google_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Google_No_Resolve.yaml",
    },
    Instagram: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Instagram/Instagram_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Instagram_No_Resolve.yaml",
    },
    Spotify: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Spotify/Spotify_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Spotify_No_Resolve.yaml",
    },
    Microsoft: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Microsoft/Microsoft_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/Microsoft_No_Resolve.yaml",
    },
    PayPal: {
      type: "http",
      behavior: "classical",
      url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/PayPal/PayPal_No_Resolve.yaml",
      interval: 86400,
      path: "./ruleset/PayPal_No_Resolve.yaml",
